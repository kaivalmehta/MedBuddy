# ============================================
# MedBuddy - Development Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# ==========================================
# Django Settings
# ==========================================
DEBUG=True
SECRET_KEY=your-development-secret-key-change-in-production

# ==========================================
# Database Configuration
# ==========================================
DB_NAME=medbuddy_db
DB_USER=medbuddy_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# Application URLs
# ==========================================
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# Azure Blob Storage
# ==========================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=prescriptions

# ==========================================
# Azure AI Vision (Computer Vision)
# ==========================================
AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/
AZURE_VISION_KEY=

# ==========================================
# Azure OpenAI
# ==========================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ==========================================
# Azure Speech Services
# ==========================================
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ==========================================
# Azure Maps
# ==========================================
AZURE_MAPS_KEY=

# ==========================================
# Azure Translator
# ==========================================
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=eastus

# ==========================================
# Azure Communication Services (Email)
# ==========================================
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=DoNotReply@your-domain.azurecomm.net

# ==========================================
# Email Settings
# ==========================================
DEFAULT_FROM_EMAIL=MedBuddy <noreply@medbuddy.com>
ADMIN_EMAIL=admin@medbuddy.com

# ==========================================
# Redis Cache (Optional)
# ==========================================
REDIS_URL=redis://localhost:6379/0
