# backend/users/serializers.py
# REPLACE your entire users/serializers.py with this

from rest_framework import serializers
from django.contrib.auth import authenticate
from django.contrib.auth.password_validation import validate_password
from .models import User, HealthProfile, FamilyMember, DoctorProfile, LaboratoryProfile, PatientAccessToken


class UserSerializer(serializers.ModelSerializer):
    class Meta:
        model = User
        fields = ['id', 'email', 'username', 'first_name', 'last_name', 'role', 
                  'phone', 'preferred_language', 'is_verified', 'receive_email_notifications', 'created_at']
        read_only_fields = ['id', 'is_verified', 'created_at']


class RegisterSerializer(serializers.ModelSerializer):
    password = serializers.CharField(write_only=True, validators=[validate_password])
    password_confirm = serializers.CharField(write_only=True)
    
    # Optional profile data based on role
    doctor_profile = serializers.JSONField(required=False, write_only=True)
    laboratory_profile = serializers.JSONField(required=False, write_only=True)
    pharmacy_profile = serializers.JSONField(required=False, write_only=True)
    
    class Meta:
        model = User
        fields = ['email', 'username', 'password', 'password_confirm', 'first_name', 
                  'last_name', 'role', 'phone', 'doctor_profile', 'laboratory_profile', 'pharmacy_profile']
    
    def validate(self, attrs):
        if attrs['password'] != attrs['password_confirm']:
            raise serializers.ValidationError({'password_confirm': 'Passwords do not match'})
        return attrs

    def create(self, validated_data):
        validated_data.pop('password_confirm')
        doctor_data = validated_data.pop('doctor_profile', None)
        lab_data = validated_data.pop('laboratory_profile', None)
        pharmacy_data = validated_data.pop('pharmacy_profile', None)
        
        user = User.objects.create_user(**validated_data)
        
        # Create role-specific profile with defaults
        if user.role == 'patient':
            HealthProfile.objects.create(user=user)
        
        elif user.role == 'doctor':
            DoctorProfile.objects.create(
                user=user,
                full_name=f"{user.first_name} {user.last_name}",
                specialization=doctor_data.get('specialization', 'General Practice') if doctor_data else 'General Practice',
                qualification=doctor_data.get('qualification', 'MBBS') if doctor_data else 'MBBS',
                registration_number=doctor_data.get('registration_number', f'PENDING-{user.id}') if doctor_data else f'PENDING-{user.id}',
            )
        
        elif user.role == 'laboratory':
            LaboratoryProfile.objects.create(
                user=user,
                name=lab_data.get('name', f"{user.first_name}'s Laboratory") if lab_data else f"{user.first_name}'s Laboratory",
                license_number=lab_data.get('license_number', f'PENDING-{user.id}') if lab_data else f'PENDING-{user.id}',
                address=lab_data.get('address', 'Please update') if lab_data else 'Please update',
                city=lab_data.get('city', 'Please update') if lab_data else 'Please update',
                state=lab_data.get('state', 'Please update') if lab_data else 'Please update',
                zip_code=lab_data.get('zip_code', '00000') if lab_data else '00000',
                phone=user.phone or '0000000000',
            )
        
        elif user.role == 'pharmacy':
            from pharmacy.models import Pharmacy
            Pharmacy.objects.create(
                user=user,
                name=pharmacy_data.get('name', f"{user.first_name}'s Pharmacy") if pharmacy_data else f"{user.first_name}'s Pharmacy",
                license_number=pharmacy_data.get('license_number', f'PENDING-{user.id}') if pharmacy_data else f'PENDING-{user.id}',
                address=pharmacy_data.get('address', 'Please update') if pharmacy_data else 'Please update',
                city=pharmacy_data.get('city', 'Please update') if pharmacy_data else 'Please update',
                state=pharmacy_data.get('state', 'Please update') if pharmacy_data else 'Please update',
                zip_code=pharmacy_data.get('zip_code', '00000') if pharmacy_data else '00000',
                phone=user.phone or '0000000000',
                email=user.email,
            )
        
        return user

class LoginSerializer(serializers.Serializer):
    email = serializers.EmailField()
    password = serializers.CharField(write_only=True)
    
    def validate(self, attrs):
        user = authenticate(username=attrs['email'], password=attrs['password'])
        if not user:
            raise serializers.ValidationError('Invalid email or password')
        if not user.is_active:
            raise serializers.ValidationError('Account is disabled')
        attrs['user'] = user
        return attrs


class HealthProfileSerializer(serializers.ModelSerializer):
    age = serializers.SerializerMethodField()
    
    class Meta:
        model = HealthProfile
        fields = ['id', 'date_of_birth', 'age', 'gender', 'blood_type', 'weight_kg',
                  'height_cm', 'medical_conditions', 'allergies', 'current_medications',
                  'lifestyle_factors', 'emergency_contact_name', 'emergency_contact_phone',
                  'updated_at']
        read_only_fields = ['id', 'updated_at']
    
    def get_age(self, obj):
        if obj.date_of_birth:
            from datetime import date
            today = date.today()
            return today.year - obj.date_of_birth.year - (
                (today.month, today.day) < (obj.date_of_birth.month, obj.date_of_birth.day)
            )
        return None


class FamilyMemberSerializer(serializers.ModelSerializer):
    class Meta:
        model = FamilyMember
        fields = ['id', 'name', 'relationship', 'date_of_birth', 'gender', 
                  'blood_type', 'medical_conditions', 'allergies', 
                  'current_medications', 'is_active', 'created_at']
        read_only_fields = ['id', 'created_at']


class DoctorProfileSerializer(serializers.ModelSerializer):
    user = UserSerializer(read_only=True)
    
    class Meta:
        model = DoctorProfile
        fields = ['id', 'user', 'full_name', 'specialization', 'qualification',
                  'registration_number', 'clinic_name', 'clinic_address', 
                  'clinic_phone', 'is_verified', 'created_at']
        read_only_fields = ['id', 'is_verified', 'created_at']


class LaboratoryProfileSerializer(serializers.ModelSerializer):
    user = UserSerializer(read_only=True)
    
    class Meta:
        model = LaboratoryProfile
        fields = ['id', 'user', 'name', 'license_number', 'address', 'city',
                  'state', 'zip_code', 'phone', 'services', 'is_verified',
                  'operating_hours', 'created_at']
        read_only_fields = ['id', 'is_verified', 'created_at']


# ============================================
# OTP / Patient Access Serializers
# ============================================

class RequestPatientAccessSerializer(serializers.Serializer):
    """For doctors to request access to patient data"""
    patient_email = serializers.EmailField()
    purpose = serializers.ChoiceField(
        choices=['view_history', 'add_prescription', 'add_report'],
        default='view_history'
    )


class VerifyOTPSerializer(serializers.Serializer):
    """For verifying OTP and granting access"""
    patient_email = serializers.EmailField()
    otp_code = serializers.CharField(max_length=6, min_length=6)


class PatientAccessTokenSerializer(serializers.ModelSerializer):
    patient_email = serializers.EmailField(source='patient.email', read_only=True)
    requester_name = serializers.SerializerMethodField()
    
    class Meta:
        model = PatientAccessToken
        fields = ['id', 'patient_email', 'requester_name', 'purpose', 
                  'is_used', 'access_granted', 'expires_at', 'created_at']
    
    def get_requester_name(self, obj):
        if obj.requester.role == 'doctor':
            try:
                return f"Dr. {obj.requester.doctor_profile.full_name}"
            except:
                pass
        return obj.requester.email


# ============================================
# Patient Summary Serializer (for doctors viewing patient data)
# ============================================

class PatientSummarySerializer(serializers.ModelSerializer):
    """Summary of patient data for doctors"""
    health_profile = HealthProfileSerializer(read_only=True)
    recent_prescriptions_count = serializers.SerializerMethodField()
    recent_reports_count = serializers.SerializerMethodField()
    
    class Meta:
        model = User
        fields = ['id', 'email', 'first_name', 'last_name', 'phone',
                  'health_profile', 'recent_prescriptions_count', 'recent_reports_count']
    
    def get_recent_prescriptions_count(self, obj):
        return obj.prescriptions.count()
    
    def get_recent_reports_count(self, obj):
        return obj.lab_reports.count()


# ============================================
# Prescription serializers (add to prescriptions/serializers.py)
# ============================================
# Add these to your existing prescriptions/serializers.py

class SendPrescriptionToPatientSerializer(serializers.Serializer):
    """For doctors/pharmacies to send prescription to patient"""
    patient_email = serializers.EmailField()
    send_email = serializers.BooleanField(default=True)
    
    # For digital prescriptions (doctors only)
    is_digital = serializers.BooleanField(default=False)
    medications = serializers.ListField(child=serializers.DictField(), required=False)
    notes = serializers.CharField(required=False, allow_blank=True)


class DigitalPrescriptionSerializer(serializers.Serializer):
    """For doctors to create digital prescriptions"""
    patient_email = serializers.EmailField()
    prescription_date = serializers.DateField(required=False)
    medications = serializers.ListField(
        child=serializers.DictField(),
        min_length=1
    )
    notes = serializers.CharField(required=False, allow_blank=True)
    send_email = serializers.BooleanField(default=True)
    
    def validate_medications(self, value):
        required_fields = ['drug_name', 'dosage', 'frequency']
        for med in value:
            for field in required_fields:
                if field not in med:
                    raise serializers.ValidationError(
                        f"Each medication must have: {', '.join(required_fields)}"
                    )
        return value