# ============================================
# MedBuddy - Production Environment Variables
# For Azure deployment
# ============================================

# ==========================================
# Django Settings
# ==========================================
DEBUG=False
SECRET_KEY=your-very-secure-production-secret-key-min-50-chars
SECURE_SSL_REDIRECT=True

# ==========================================
# Database Configuration (Azure PostgreSQL)
# ==========================================
DB_NAME=medbuddy_db
DB_USER=medbuddy_admin@your-server-name
DB_PASSWORD=your-secure-database-password
DB_HOST=your-server-name.postgres.database.azure.com
DB_PORT=5432

# ==========================================
# Application URLs
# ==========================================
ALLOWED_HOSTS=medbuddy-backend-prod.your-region.azurecontainerapps.io
CORS_ALLOWED_ORIGINS=https://medbuddy-frontend-prod.your-region.azurecontainerapps.io
CSRF_TRUSTED_ORIGINS=https://medbuddy-frontend-prod.your-region.azurecontainerapps.io
FRONTEND_URL=https://medbuddy-frontend-prod.your-region.azurecontainerapps.io

# ==========================================
# Azure Blob Storage
# ==========================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey
AZURE_STORAGE_CONTAINER_NAME=prescriptions

# ==========================================
# Azure AI Vision (Computer Vision)
# ==========================================
AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/
AZURE_VISION_KEY=your-vision-key

# ==========================================
# Azure OpenAI
# ==========================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ==========================================
# Azure Speech Services
# ==========================================
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus

# ==========================================
# Azure Maps
# ==========================================
AZURE_MAPS_KEY=your-maps-key

# ==========================================
# Azure Translator
# ==========================================
AZURE_TRANSLATOR_KEY=your-translator-key
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=eastus

# ==========================================
# Azure Communication Services (Email)
# ==========================================
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-communication-service.communication.azure.com/;accesskey=yourkey
AZURE_EMAIL_SENDER=DoNotReply@your-domain.azurecomm.net

# ==========================================
# Email Settings
# ==========================================
DEFAULT_FROM_EMAIL=MedBuddy <noreply@medbuddy.com>
ADMIN_EMAIL=admin@medbuddy.com

# ==========================================
# Redis Cache (Azure Redis Cache)
# ==========================================
REDIS_URL=rediss://:yourpassword@your-redis-cache.redis.cache.windows.net:6380/0

# ==========================================
# Gunicorn Settings
# ==========================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ==========================================
# Superuser Creation (One-time setup)
# ==========================================
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_EMAIL=admin@medbuddy.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password
