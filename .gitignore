####################################
# Python / Django
####################################
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

####################################
# Virtual Environments
####################################
venv/
ENV/
env/
.venv/

####################################
# Django specific
####################################
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

####################################
# Environment Variables / Secrets
####################################
.env
backend/.env
frontend/.env
.env.local
.env.*.local
*.env
secrets.json
*.pem
*.key

####################################
# Logs
####################################
logs/
backend/logs/
backend/logs/*.log
*.log
*.out
*.err

####################################
# IDE / OS files
####################################
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

####################################
# Node.js
####################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

####################################
# Frontend (React / Vite)
####################################
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/

####################################
# Lockfiles (keep package-lock.json if using npm)
####################################
pnpm-lock.yaml

####################################
# Coverage / Testing
####################################
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

####################################
# Byte-compiled files
####################################
*.pyc

####################################
# Azure / Cloud
####################################
.azure/

####################################
# Git rewrite / filter-repo backups
####################################
.git/filter-repo/


